<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chidionyema.maestro</string>

    <!-- bin/maestro-run, not maestro.py: the wrapper is what reads the estate
         credential file and exports the two variables maestro needs. Calling
         the module directly is how it ran for weeks posting to an empty token. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/roseonyema/Documents/code/maestro/bin/maestro-run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/roseonyema/Documents/code/maestro</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>MAESTRO_HOME</key>
        <string>/Users/roseonyema/Documents/code/maestro</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- maestro runs its own 60s loop (Config.TICK_INTERVAL, maestro.py:41), so
         launchd keeps the process alive rather than starting a new one on a
         timer. Two copies would both poll and both write the same database. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/roseonyema/Documents/code/maestro/logs/maestro.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/roseonyema/Documents/code/maestro/logs/maestro.err.log</string>
</dict>
</plist>
