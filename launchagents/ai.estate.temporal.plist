<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Temporal dev server backing Sovereign Bus. launchd runs it directly in
  the foreground and restarts it on any exit, this is the process, not a
  wrapper around it, so KeepAlive actually supervises Temporal itself.

  Install:    bin/idp-install-launchd
  Remove:     launchctl bootout gui/$(id -u)/ai.estate.temporal
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/usr/local/share/dotnet:~/.dotnet/tools:/Library/Frameworks/Mono.framework/Versions/Current/Commands:/Users/roseonyema/.kimi-code/bin:/Users/roseonyema/.local/bin:/usr/local/opt/node@20/bin:/Users/roseonyema/anaconda3/bin:/Users/roseonyema/anaconda3/condabin:/Users/roseonyema/.cargo/bin:/Users/roseonyema/.rvm/bin</string>
		<key>HOME</key>
		<string>/Users/roseonyema</string>
	</dict>
	<key>Label</key>
	<string>ai.estate.temporal</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/temporal</string>
		<string>server</string>
		<string>start-dev</string>
		<string>--db-filename</string>
		<string>/Users/roseonyema/.estate/temporal/dev.db</string>
		<string>--namespace</string>
		<string>estate</string>
		<string>--headless</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/roseonyema/.estate/sovereign/logs/temporal-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/roseonyema/.estate/sovereign/logs/temporal-launchd.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/roseonyema/Documents/code/idp</string>
</dict>
</plist>
