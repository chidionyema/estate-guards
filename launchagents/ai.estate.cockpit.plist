<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Otto cockpit: one screen over the sovereign bus (sovereign/cockpit/README.md).
  `bin/sb cockpit` blocks serving http.server forever, so unlike ai.estate.idp this
  job needs KeepAlive, launchd is the only thing bringing it back after a crash
  or a reboot, and there is no self-restarting parent process to rely on instead.

  Install:    bin/idp-install-launchd
  Remove:     launchctl bootout gui/$(id -u)/ai.estate.cockpit
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/local/bin:/opt/local/sbin:/opt/local/bin:/opt/local/sbin:/Users/roseonyema/.rd/bin:/Users/roseonyema/.local/bin:/usr/local/bin:/Users/roseonyema/.opencode/bin:/Users/roseonyema/.estate/bin:/Users/roseonyema/.rd/bin:/Users/roseonyema/.opencode/bin:/Users/roseonyema/.nvm/versions/node/v22.15.1/bin:/Users/roseonyema/.cargo/bin:/Users/roseonyema/.local/bin:/Users/roseonyema/.cache/estate-tools:/Users/roseonyema/Documents/code/idp/bin:/Users/roseonyema/.cache/estate-tools:/Users/roseonyema/Documents/code/idp/bin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/share/dotnet:~/.dotnet/tools:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin</string>
		<key>HOME</key>
		<string>/Users/roseonyema</string>
	</dict>
	<key>Label</key>
	<string>ai.estate.cockpit</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/roseonyema/.estate/runtime/idp/bin/sb</string>
		<string>cockpit</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>/Users/roseonyema/.estate/runtime/idp/run/cockpit-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/roseonyema/.estate/runtime/idp/run/cockpit-launchd.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/roseonyema/.estate/runtime/idp</string>
</dict>
</plist>
