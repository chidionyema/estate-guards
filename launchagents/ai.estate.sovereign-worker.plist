<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Sovereign Bus worker: `bin/sb worker` in the foreground. Depends on
  ai.estate.temporal being reachable; the client retries its own connect,
  so KeepAlive restarting this faster than Temporal comes up is harmless.

  Install:    bin/idp-install-launchd
  Remove:     launchctl bootout gui/$(id -u)/ai.estate.sovereign-worker
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/usr/local/share/dotnet:~/.dotnet/tools:/Library/Frameworks/Mono.framework/Versions/Current/Commands:/Users/roseonyema/.kimi-code/bin:/Users/roseonyema/.local/bin:/usr/local/opt/node@20/bin:/Users/roseonyema/anaconda3/bin:/Users/roseonyema/anaconda3/condabin:/Users/roseonyema/.cargo/bin:/Users/roseonyema/.rvm/bin</string>
		<key>HOME</key>
		<string>/Users/roseonyema</string>
	</dict>
	<key>Label</key>
	<string>ai.estate.sovereign-worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/roseonyema/Documents/code/idp/bin/sb</string>
		<string>worker</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardErrorPath</key>
	<string>/Users/roseonyema/.estate/sovereign/logs/worker-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/roseonyema/.estate/sovereign/logs/worker-launchd.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/roseonyema/Documents/code/idp</string>
</dict>
</plist>
