<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- estate-db's research database on loopback, so the laptop's /fleet shows the research
     department's claims (bin/idp-research-tunnel). Read-only role; loopback only. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.estate.research-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/roseonyema/.estate/bin/idp-research-tunnel</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/roseonyema</string>
    <!-- kubectl is Rancher Desktop's (~/.rd/bin) and the kubeconfig's exec plugin (~/bin/oke-token)
         runs `oci` (~/.local/bin): without both the job cannot authenticate, as ai.estate.kubeapi
         measured (exit 126, 2026-10-12). -->
    <key>PATH</key><string>/Users/roseonyema/.rd/bin:/Users/roseonyema/.local/bin:/Users/roseonyema/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/roseonyema/.estate/research-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/roseonyema/.estate/research-tunnel.log</string>
</dict>
</plist>
