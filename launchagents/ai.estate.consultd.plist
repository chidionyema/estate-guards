<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.estate.consultd</string>
  <!-- Apple's own signed python3 on purpose: an unsigned Homebrew or uv
       interpreter makes macOS re-prompt "Python wants to access data from
       other apps" every time launchd starts it. consultd is stdlib only, so
       the system interpreter is enough. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/roseonyema/Documents/code/claude-guards/consultd.py</string>
    <string>serve</string>
  </array>
  <!-- launchd hands a process a minimal PATH, so the daemon once reported a
       CLI backend "not on PATH" while the same binary resolved fine in a
       shell. A daemon that cannot see the tools it is meant to cascade over
       is not degraded, it is lying about what it has. Nothing in the current
       cascade is found by PATH, but the next one added will be. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/roseonyema/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/roseonyema/.estate/logs/consultd.log</string>
  <key>StandardErrorPath</key><string>/Users/roseonyema/.estate/logs/consultd.log</string>
  <key>WorkingDirectory</key><string>/Users/roseonyema/.estate</string>
</dict>
</plist>
