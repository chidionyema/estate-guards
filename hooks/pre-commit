#!/usr/bin/env python3
"""Refuse a commit that stages anything shaped like a credential.

LAW 21: a secret never reaches a place it can be read again, and a commit is
exactly such a place. LAW 24 put ~/.claude under version control, which means
`git add -A` here now runs across the whole agent-configuration surface. This
hook is what makes that safe rather than merely intended.

It reads the STAGED blob (`git show :path`), not the working tree, because the
two differ precisely when someone stages a file and then edits it.

The detection is tracked.py's SECRET regex, imported rather than copied, so one
pattern list serves the copier and the commit gate (LAW 3).

Installed with:  git config core.hooksPath scripts/hooks
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
import tracked  # noqa: E402
from tracked import SECRET  # noqa: E402

# The file that defines the patterns contains the patterns, so the gate refuses
# its own source. Skip exactly that one file, resolved from the module rather
# than typed as a name, so renaming it cannot silently open a hole. Anything
# else that wants an exemption goes in .gitignore, where it is visible.
SELF = os.path.realpath(tracked.__file__)


# A scanner's source contains the shapes it scans for. tracked.py was exempted by
# path, which fixed that one file and left the class open: estate_audit.py carries
# the same patterns and this gate refused it too. A match is a PATTERN, not a value,
# when the line it sits on is regex source -- a character class, a quantifier, or an
# re.compile call. No real credential contains "[A-Za-z" or "{20,}".
#
# LIMITATION, written down rather than discovered later: a real secret pasted onto a
# line that also holds regex syntax would pass. That is a narrow hole and the trade is
# deliberate -- a gate that refuses every scanner in the estate is a gate somebody
# turns off with --no-verify, which opens the whole thing.
PATTERN_MARKS = ("[A-Za-z", "[0-9", "[a-z", "re.compile", "\\b", "{20,", "{30,", "{34,", "{40,", "{50,")


def is_pattern(text: str, m) -> bool:
    start = text.rfind("\n", 0, m.start()) + 1
    end = text.find("\n", m.end())
    line = text[start:end if end >= 0 else len(text)]
    return any(k in line for k in PATTERN_MARKS)


def staged_paths():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM", "-z"],
        capture_output=True, text=True, check=True).stdout
    return [p for p in out.split("\0") if p]


def staged_blobs(paths):
    """{path: bytes} for every staged path, in ONE git process.

    A `git show` per file costs a process per file. On the commit that first put
    ~/.claude under version control that was 625 of them, and the hook was still
    running two minutes later. A gate slow enough to be killed is a gate nobody
    keeps (LAW 28). `cat-file --batch` reads every object over one pipe.
    """
    out = {}
    if not paths:
        return out
    # cat-file --batch splits its input on newlines, so a path containing one
    # cannot go through it. Those are read individually; there are none here.
    batch = [p for p in paths if "\n" not in p]
    for path in (p for p in paths if "\n" in p):
        r = subprocess.run(["git", "show", f":{path}"], capture_output=True)
        out[path] = r.stdout if r.returncode == 0 else b""

    raw = subprocess.run(["git", "cat-file", "--batch"],
                         input="".join(f":{p}\n" for p in batch).encode(),
                         capture_output=True).stdout
    pos = 0
    for path in batch:
        nl = raw.find(b"\n", pos)
        if nl < 0:
            break
        header = raw[pos:nl].split(b" ")
        if len(header) < 3:          # "<rev> missing" -- no blob, nothing to scan
            pos = nl + 1
            continue
        size = int(header[2])
        out[path] = raw[nl + 1:nl + 1 + size]
        pos = nl + 1 + size + 1      # blob, then the newline git writes after it
    return out


#: The two checkouts every session on this machine shares. A commit here is
#: never one agent's private business, because five other sessions have the same
#: working tree open and stage into the same index.
SHARED = ("/Documents/code/claude-estate/scripts", "/Documents/code/claude-estate")


def shared_branch_warning():
    """Say it at the moment it can still be avoided, not an hour later.

    Three times in one afternoon a session ran `git add -A` in a shared checkout
    that another session had left on a feature branch. Five files written for the
    load-bearing sweep were committed to `zz-gate-test`, where nothing on main
    could see them, and had to be recovered one at a time. A commit on main is
    visible to every session; a commit on a stray branch in a shared checkout is
    the trap.

    This warns rather than refuses. Refusing would wedge whichever session is
    mid-branch right now, and a warning printed into an agent's own tool output
    has a reader, which an hourly report does not.
    """
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True).stdout.strip()
        head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                              capture_output=True, text=True).stdout.strip()
    except Exception:
        return
    if not top or not any(top.endswith(s) for s in SHARED):
        return
    if head in ("main", "HEAD"):      # HEAD means a detached worktree, which is the fix
        return
    print(f"WARNING: committing to '{head}' in a shared checkout ({top}).",
          file=sys.stderr)
    print("Five other sessions have this working tree open. Work committed here",
          file=sys.stderr)
    print("does not reach main, and the next `git add -A` by any of them will",
          file=sys.stderr)
    print("sweep your files onto this branch. Use your own worktree instead:",
          file=sys.stderr)
    print(f"  git -C {top} worktree add /tmp/wt-$$ main", file=sys.stderr)
    print("See crew #40 for the allocation. The commit is going ahead.",
          file=sys.stderr)


#: The one directory in ~/.claude that must never be committed again.
#: It held 878 checkpoint notes and 704 memory files -- the founder's own words,
#: the estate's infrastructure, and every conclusion six sessions reached. All of
#: it sat in a GitHub repository until 2026-08-23. Founder: "this shold not be
#: ingithub". .gitignore already excludes it, but .gitignore is one `git add -f`
#: away from being wrong, and the mistake is silent: the files reappear in a
#: commit nobody reads and reach the remote thirty minutes later.
#:
#: Scoped to the ~/.claude checkout by top-level path, because this hook is shared
#: from claude-guards and another repository may legitimately hold a projects/.
FORBIDDEN = "projects/"


def refuse_projects(paths):
    """Paths under projects/ staged in a checkout that must never hold them, if any."""
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True).stdout.strip()
    except Exception:
        return []
    if not top.endswith("/claude-estate"):
        return []
    return [p for p in paths if p.startswith(FORBIDDEN)]


def silent_handlers(paths, blobs):
    """New places where a guard's side effect fails without saying so.

    Same shape as the credential gate above and for the same reason: 24 of these
    were found on 2026-08-23 and every one of them had passed review, because a
    swallowed write reads as caution rather than as a guard going dark. Fixing
    the 24 closed the instances. This closes the class.

    Reads the STAGED blob, like everything else here, so staging a file and then
    editing it cannot slip a handler past.
    """
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True).stdout.strip()
    except Exception:
        return []
    #: Only this checkout. The gate is global now, and refusing a swallowed
    #: write in somebody else's repository is an opinion, not a guard.
    if not top.endswith("/claude-estate/scripts"):
        return []
    try:
        import silent_side_effect as det
    except Exception:
        #: Loud, not silent. A missing detector is exactly the failure it exists
        #: to find, and a check that cannot run must refuse rather than pass.
        print("COMMIT REFUSED: silent_side_effect.py is missing, so this gate "
              "could not run.", file=sys.stderr)
        return [("silent_side_effect.py", 0, ["the detector itself"])]
    out = []
    for path in paths:
        if not path.endswith(".py"):
            continue
        blob = blobs.get(path, b"")
        if b"\0" in blob or not blob:
            continue
        tmp = f"/tmp/.silentgate-{os.path.basename(path)}"
        try:
            with open(tmp, "wb") as fh:
                fh.write(blob)
            for lineno, caught, acts in det.scan(tmp):
                if set(acts) - det.CLEANUP_ONLY:
                    out.append((path, lineno, sorted(set(acts))))
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    return out


#: An encrypted secret store is safe to commit ONLY where the ciphertext is not
#: world-readable. Measured 2026-08-23 in chidionyema/prospector, which is PUBLIC:
#: deploy/secrets.env.age had been committed in 4 snapshot commits, and GitHub
#: still serves that blob by sha (87600ac4) even though no branch reaches it. It
#: holds 25 credentials whose values are unchanged today, Stripe live keys and the
#: Fly token among them.
#:
#: age is not broken and the private key has never been in git, so nothing is
#: readable. That is exactly why this is a guard and not an incident: the exposure
#: is permanent and silent, and it only becomes a breach later, on the day the key
#: leaks -- at which point the ciphertext cannot be recalled from a public archive.
#:
#: The rule is the pairing, not the file. Ciphertext plus a private remote is the
#: design working. Ciphertext plus a public remote is a decision nobody made.
CIPHERTEXT = (b"age-encryption.org/v1", b"-----BEGIN PGP MESSAGE")
VIS_CACHE = os.path.join(os.path.expanduser("~"), ".estate", "state", "repo-visibility.json")


def _remote_is_public():
    """True, False, or None when it genuinely cannot be established.

    None is not "probably fine". main() treats it as public, because the cost of
    being wrong that way is a refused commit and the cost of the other way is a
    permanent public copy of every production credential.
    """
    try:
        url = subprocess.run(["git", "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    if not url:
        return False          # no remote: nothing leaves this disk
    try:
        with open(VIS_CACHE) as fh:
            cache = json.load(fh)
    except (OSError, ValueError):
        cache = {}
    if url in cache:
        return cache[url]
    try:
        out = subprocess.run(["gh", "repo", "view", url, "--json", "isPrivate",
                              "-q", ".isPrivate"],
                             capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    answer = out.stdout.strip().lower()
    if answer not in ("true", "false"):
        return None
    public = answer == "false"
    cache[url] = public
    try:
        os.makedirs(os.path.dirname(VIS_CACHE), exist_ok=True)
        with open(VIS_CACHE, "w") as fh:
            json.dump(cache, fh)
    except OSError as exc:
        sys.path.append(os.path.join(os.path.expanduser("~"), ".estate", "state"))
        import guard_report
        guard_report.broken(__file__, 0, f"cannot cache repo visibility: {exc}")
    return public


ALLOW_REL = os.path.join(".estate", "public-ciphertext-ok")


def _declared_public_ciphertext(paths):
    """This repository's own written statement that its ciphertext may be public.

    hermes-v2 does this deliberately: the age ciphertext ships in the image and the
    key is a Fly secret, which is the standard sealed-secret shape and not a mistake.
    A guard that refuses it would be worked around with ESTATE_GUARDS_OFF=1, and a
    guard people routinely switch off is not a guard.

    Returns the declaration text, or None. Three conditions, each closing a way the
    exemption could be granted without a person ever seeing it:

      - the file is TRACKED, so adding it was itself a reviewable commit;
      - it is not staged in THIS commit, so the exemption cannot arrive inside the
        very change it exempts;
      - it says something. An empty opt-out file records a decision nobody made, so
        the floor is 40 characters naming where the key lives and why it is not here.

    Every failure path returns None, which refuses. That is the behaviour, not a
    swallowed error: a wrong refusal costs one command, a wrong pass costs every
    credential in the file, permanently and in public.
    """
    if ALLOW_REL in paths:
        return None
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
        if not top:
            return None
        tracked_here = subprocess.run(["git", "ls-files", "--error-unmatch", ALLOW_REL],
                                      capture_output=True, text=True, timeout=10, cwd=top)
        if tracked_here.returncode != 0:
            return None
        with open(os.path.join(top, ALLOW_REL)) as fh:
            body = "\n".join(ln for ln in fh.read().splitlines()
                             if ln.strip() and not ln.lstrip().startswith("#")).strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return body if len(body) >= 40 else None


def refuse_ciphertext_to_public(paths, blobs):
    """Staged encrypted stores, when this repository's remote is not private."""
    hits = [p for p in paths
            if blobs.get(p, b"").startswith(CIPHERTEXT)]
    if not hits:
        return [], True
    public = _remote_is_public()
    if public is False:
        return [], True
    declared = _declared_public_ciphertext(paths)
    if declared:
        print("note: encrypted store into a public remote, allowed by "
              f"{ALLOW_REL}: {declared.splitlines()[0][:100]}", file=sys.stderr)
        return [], True
    return hits, public is True


def main():
    shared_branch_warning()
    staged = staged_paths()
    forbidden = refuse_projects(staged)
    if forbidden:
        print("COMMIT REFUSED: projects/ does not go in this repository.", file=sys.stderr)
        for path in forbidden[:10]:
            print(f"  {path}", file=sys.stderr)
        if len(forbidden) > 10:
            print(f"  ... and {len(forbidden) - 10} more", file=sys.stderr)
        print("", file=sys.stderr)
        print("These are conversation checkpoints and project memory. They were", file=sys.stderr)
        print("removed from this repository and from all of its history on", file=sys.stderr)
        print("2026-08-23 by the founder's instruction. They stay on disk and go", file=sys.stderr)
        print("to the offsite backup; they do not go to a code-hosting vendor.", file=sys.stderr)
        print("Do not use --no-verify and do not re-admit them in .gitignore.", file=sys.stderr)
        return 1
    bad = []
    paths = [p for p in staged if os.path.realpath(p) != SELF]
    blobs = staged_blobs(paths)

    cipher, certain = refuse_ciphertext_to_public(paths, blobs)
    if cipher:
        where = "is PUBLIC" if certain else "could not be confirmed private"
        print(f"COMMIT REFUSED: an encrypted secret store, and this remote {where}.",
              file=sys.stderr)
        for path in cipher[:10]:
            print(f"  {path}", file=sys.stderr)
        print("", file=sys.stderr)
        print("age is not broken, so nothing is readable today. The problem is that a", file=sys.stderr)
        print("public git object is permanent: it stays fetchable by sha after the", file=sys.stderr)
        print("branch is gone, so the day the private key leaks, every credential in", file=sys.stderr)
        print("here is readable retroactively and cannot be recalled.", file=sys.stderr)
        print("", file=sys.stderr)
        print("Make the repository private, or keep the store out of it.", file=sys.stderr)
        print("", file=sys.stderr)
        print("If the shape is deliberate -- ciphertext in the repo, key held elsewhere --", file=sys.stderr)
        print(f"say so in {ALLOW_REL} and commit that file on its own. It must be", file=sys.stderr)
        print("tracked, at least 40 characters of prose, and not staged in the same", file=sys.stderr)
        print("commit it exempts, so the allowance is a change someone can review.", file=sys.stderr)
        print("The one-off escape leaves no such record:", file=sys.stderr)
        print("  ESTATE_GUARDS_OFF=1 git commit ...", file=sys.stderr)
        return 1
    for path in paths:
        blob = blobs.get(path, b"")
        if b"\0" in blob:
            continue  # binary, not a config file
        text = blob.decode("utf-8", "replace")
        m = next((x for x in SECRET.finditer(text) if not is_pattern(text, x)), None)
        if m:
            # Report WHERE, never WHAT. Any slice of the match is a slice of the
            # secret -- `sk-[A-Za-z0-9]{20,}` truncated to 8 chars is five real
            # characters of the key on the screen, which is the thing being
            # stopped. The line number is enough for a person to go and look.
            line = text.count("\n", 0, m.start()) + 1
            bad.append((path, line))

    silent = silent_handlers(paths, blobs)
    if silent:
        print("COMMIT REFUSED: a guard here cannot report its own failure.",
              file=sys.stderr)
        for path, lineno, acts in silent:
            print(f"  {path}:{lineno}  swallows a failed {', '.join(acts)}",
                  file=sys.stderr)
        print("", file=sys.stderr)
        print("The try does something -- writes a file, sends a message, runs a", file=sys.stderr)
        print("command -- and the except is nothing but `pass`. When that write", file=sys.stderr)
        print("fails, the guard carries on and reports success, so a dead guard", file=sys.stderr)
        print("and a working one leave identical evidence. session-recorder was", file=sys.stderr)
        print("that way for two days and its tier stayed green throughout.", file=sys.stderr)
        print("", file=sys.stderr)
        print("Replace the `pass` with:", file=sys.stderr)
        print("  try: (__import__(\"sys\").path.append(__import__(\"os\").path"
              ".expanduser(\"~/.claude/scripts\")), "
              "__import__(\"guard_report\").broken(__file__, LINE))", file=sys.stderr)
        print("  except Exception: pass", file=sys.stderr)
        print("", file=sys.stderr)
        print("Deleting a leftover temp file is exempt and needs no change.", file=sys.stderr)
        return 1

    if not bad:
        return 0

    print("COMMIT REFUSED: staged content looks like a credential.", file=sys.stderr)
    for path, line in bad:
        print(f"  {path}:{line}", file=sys.stderr)
    print("", file=sys.stderr)
    print("Take the value out of the file and point at it instead, or add the", file=sys.stderr)
    print("path to .gitignore. Do not use --no-verify: the value is committed", file=sys.stderr)
    print("the moment you do, and rotating it is then the only fix.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
