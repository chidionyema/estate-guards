#!/usr/bin/env python3
"""Two push gates: LAW 32 (a feature ships with a demo and an onboarding) and
LAW 7 (refresh on main before you ask for review).

LAW 32 -- refuse a push that ships a feature the founder cannot see or try.

The founder's rule, in his words: "every new feature needs demo and onboarding
for founder ... can this be enforced in git ?" This is the yes.

A feature is not code. It is code plus the two things that make it reach a
person: a demo that shows it working, and an onboarding note that says what he
needs to know and how to stop it. Shipping the code alone leaves him to work it
out, which LAW 20 already calls a defect with the same standing as a crash. The
difference a hook makes is that the defect can no longer be pushed.

WHAT COUNTS AS A FEATURE, mechanically, so nobody has to interpret it:

  1. A commit subject starting `feat:` or `feat(scope):`. Explicit, and the way
     to opt in deliberately.
  2. A brand-new top-level directory that the push adds source files to. That is
     what a new feature looks like in this estate when nobody remembered to
     write `feat:` -- `aiden/` arrived exactly that way.

WHAT IT DEMANDS. For a feature named X, both files present in the pushed tree:

     docs/demo/X.md         what a person sees when it runs, and what it did
     docs/onboarding/X.md   what he needs to know, and the one command to stop it

Both must be non-trivial. A file with a heading and nothing under it is a way of
satisfying a gate without satisfying the founder, so an empty stub is refused
with the same message as a missing file.

WHAT IT DOES NOT DO. It does not fire on a docs-only push, a fix, a refactor, or
a new file in a directory that already exists. A gate that fires on everything
gets `--no-verify`d, and a bypassed gate protects nothing.

Installed per repository with:  git config core.hooksPath scripts/hooks
"""
import json
import os
import re
import subprocess
import sys

#: Directories that are not features no matter what lands in them.
IGNORED_TOP = {
    "docs", "test", "tests", "spec", ".github", ".git", "vendor", "node_modules",
    "dist", "build", "assets", "static", "fixtures", "examples", "scripts",
    "checkpoints", "state", "evidence", "__pycache__", ".venv",
}
SOURCE = re.compile(r"\.(py|sh|js|ts|tsx|go|rs|rb|java|cs|swift|c|cc|cpp|h|mjs)$")
#: The scope names the feature when there is one, and the first word after the
#: colon only when there is not. `feat(friction-relay): carry the founder's
#: complaints to every session` used to be read as a feature called "carry",
#: because the pattern skipped the scope and took the verb. The gate then
#: refused the push until somebody wrote docs/demo/carry.md, which is a page
#: about a verb. Measured 2026-08-23: that refusal blocked five commits on
#: claude-guards main, four of them from other sessions.
FEAT = re.compile(
    r"^feat(?:\((?P<scope>[\w.-]+)\))?\s*:\s*(?P<word>[\w.-]+)", re.I)
#: A body this short is a placeholder, not a demo.
MIN_BODY_CHARS = 200
#: LAW 7's escape hatch, in the shape the estate's other fences already use.
STALE_OK = re.compile(r"(?im)^\s*Stale-OK:\s*\S")
#: Pushing these IS the integration; they cannot be stale against themselves.
TRUNK = {"main", "master"}
#: LAW 22's escape hatch, same shape as LAW 7's.
EVIDENCE_OK = re.compile(r"(?im)^\s*No-Evidence:\s*\S")
#: The tool that already knows what evidence looks like. Do not reimplement it.
PR_EVIDENCE = os.path.expanduser("~/Documents/code/claude-estate/scripts/pr-evidence.py")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout


def commits(local, remote):
    """The commits this push would add. An all-zero remote means a new branch."""
    if remote and set(remote) != {"0"}:
        rng = f"{remote}..{local}"
    else:
        #: A new branch on the remote. Everything not already on some other
        #: remote branch is new, which is the honest reading of "this push adds".
        rng = local
        others = git("rev-list", "--max-count=1", "--all", "--remotes").strip()
        if others:
            rng = f"--not --remotes {local}"
            return [c for c in git("rev-list", local, "--not", "--remotes").split() if c]
    return [c for c in git("rev-list", rng).split() if c]


def paired_docs(local, shas):
    """Feature names this push adds BOTH a demo and an onboarding for.

    Read off the added files, not off the commit subject, so a `feat:` with no scope is judged
    on what it actually ships. Both halves are required: a demo with no onboarding is a page
    showing something work with no way to stop it.
    """
    seen = {"demo": set(), "onboarding": set()}
    for sha in shas:
        added = git("diff-tree", "--no-commit-id", "--name-only", "-r",
                    "--diff-filter=A", sha).split("\n")
        for path in added:
            path = path.strip()
            for kind in seen:
                prefix = f"docs/{kind}/"
                if path.startswith(prefix) and path.endswith(".md"):
                    seen[kind].add(path[len(prefix):-3])
    return sorted(seen["demo"] & seen["onboarding"])


def features(local, shas):
    """Every feature name this push introduces, with why it counts.

    Judged against the tip, not against each commit on the way to it. A push
    that creates a directory in one commit and deletes it in the next ships no
    feature, and demanding docs for it is the gate asking for a page about
    something that will not exist. The first version did exactly that and
    refused its own cleanup commit.
    """
    found = {}
    for sha in shas:
        subject = git("log", "-1", "--format=%s", sha).strip()
        m = FEAT.match(subject)
        if m:
            #: The scope names the feature. Without one, the gate does not know the name and
            #: must not guess: `feat: no session changes a file without a GitHub issue` was read
            #: as a feature called "no" and the push was refused until somebody wrote
            #: docs/demo/no.md. That is the same defect the scope rule above was written for,
            #: one step further along -- the first fix covered `feat(scope):` and left the bare
            #: `feat:` still taking the verb.
            #:
            #: So when there is no scope, the demand is the law's demand and nothing more: this
            #: push adds a demo and an onboarding that go together. Which name they carry is the
            #: author's business, not the gate's.
            name = m.group("scope")
            if name:
                found.setdefault(name, f"commit {sha[:8]} says `{subject[:60]}`")
            else:
                for pair in paired_docs(local, shas):
                    found.setdefault(pair, f"commit {sha[:8]} says `{subject[:60]}`")
                if not paired_docs(local, shas):
                    found.setdefault(m.group("word"),
                                     f"commit {sha[:8]} says `{subject[:60]}` and this push adds "
                                     f"no docs/demo + docs/onboarding pair")
        #: Files this commit ADDED, against its first parent. A new top-level
        #: directory shows up here as the first source file inside it.
        added = git("diff-tree", "--no-commit-id", "--name-only", "-r",
                    "--diff-filter=A", sha).split("\n")
        for path in added:
            path = path.strip()
            if "/" not in path or not SOURCE.search(path):
                continue
            top = path.split("/")[0]
            if top in IGNORED_TOP or top.startswith("."):
                continue
            #: New only if the directory did not exist before this commit.
            before = git("ls-tree", "--name-only", f"{sha}^", top).strip()
            if before:
                continue
            #: And it has to survive to the tip. Gone by then, never shipped.
            if not git("ls-tree", "--name-only", local, top).strip():
                continue
            found.setdefault(top, f"commit {sha[:8]} creates {top}/ with {path}")
    return found


def readable(local, path):
    body = git("show", f"{local}:{path}")
    if not body.strip():
        return None
    #: Strip headings and blank lines. What is left is what a person would read.
    prose = "\n".join(l for l in body.splitlines()
                      if l.strip() and not l.lstrip().startswith("#"))
    return len(prose)


def branch_of(local_ref):
    """The branch name a local ref stands for.

    `git push origin HEAD` hands the hook the literal string HEAD, not the ref
    it points at. Splitting that on "/" yields "HEAD", so a push of main made
    that way missed the TRUNK exemption below and LAW 22 went looking for a
    pull request called HEAD. Ask git what HEAD is instead of guessing.
    """
    if local_ref == "HEAD":
        return git("symbolic-ref", "--short", "-q", "HEAD").strip() or "HEAD"
    #: Strip the refs/heads/ prefix only. Splitting on the last slash turned
    #: feature/x into x, which named the wrong thing in the refusal message.
    return local_ref[len("refs/heads/"):] if local_ref.startswith("refs/heads/") else local_ref


def stale(local_ref, local_sha, shas):
    """LAW 7: refuse a branch that has not been refreshed on main.

    Founder's law, and the reason it is mechanical: a stale branch does not fail
    honestly. It fails as somebody else's bug, naming files and tests the diff
    never touched, and the author then debugs a fiction. The probe in
    science/law_enforcement.py listed LAW 7 as mechanical-but-not-live; this is
    the wire.

    Asks the REMOTE, not the local ref. `git rev-list --count HEAD..origin/main`
    answers 0 against an unfetched origin/main, which is exactly the branch this
    check is about, so it fetches first.

    Never fires on main itself: pushing trunk IS the integration.
    """
    branch = branch_of(local_ref)
    if branch in TRUNK:
        return None
    if any(STALE_OK.search(git("show", "-s", "--format=%B", c)) for c in shas):
        return None
    if subprocess.run(["git", "fetch", "origin", "main", "--quiet"],
                      capture_output=True).returncode != 0:
        return None                      # no main to be stale against; fail open
    if not git("rev-parse", "--verify", "--quiet", "origin/main").strip():
        return None
    behind = git("rev-list", "--count", f"{local_sha}..origin/main").strip()
    if behind.isdigit() and int(behind) > 0:
        return (f"  {branch} is {behind} commit(s) behind origin/main")
    return None


def evidence(local_ref, shas):
    """LAW 22: a pull request under review carries a picture of the green run.

    Pasted text is typed by hand in seconds and reads identically whether the
    run happened or not. A screenshot is a photograph of something that existed.
    It is not proof against a determined forger and it is not meant to be. It
    raises the cost of a claim from zero to something, and zero is where every
    false green has come from.

    Only fires when an OPEN pull request already exists for the branch, which is
    the moment the law is actually about: before review is asked for. The first
    push, which creates the branch, has nothing to attach evidence to yet.

    Fails open on every unknown: no gh, not authenticated, no pull request, the
    checker missing. A gate that blocks a push because a network call failed has
    stopped the estate to enforce a screenshot.
    """
    branch = branch_of(local_ref)
    if branch in TRUNK:
        return None
    if any(EVIDENCE_OK.search(git("show", "-s", "--format=%B", c)) for c in shas):
        return None
    # The push that CARRIES the evidence is the one push this gate must never
    # refuse. `pr-evidence.py attach` commits the image under docs/evidence/pr-<n>/
    # and pushes it, and only then edits the body to link it -- so on 2026-08-24 the
    # gate refused attach itself, and the only command that satisfies the gate could
    # not be run. A fence that refuses correct work is an outage (LAW 38).
    if any(path.startswith("docs/evidence/")
           for c in shas
           for path in git("show", "--pretty=", "--name-only", c).splitlines()):
        return None
    if not os.path.exists(PR_EVIDENCE):
        return None
    try:
        r = subprocess.run(["gh", "pr", "view", branch, "--json", "number,state"],
                           capture_output=True, text=True, timeout=25)
    except Exception:
        return None
    if r.returncode != 0:
        return None                      # no PR yet, or no gh: nothing to gate
    try:
        info = json.loads(r.stdout)
    except ValueError:
        return None
    if info.get("state") != "OPEN" or not info.get("number"):
        return None
    n = info["number"]
    try:
        c = subprocess.run([sys.executable, PR_EVIDENCE, "check", "--pr", str(n)],
                           capture_output=True, text=True, timeout=60)
    except Exception:
        return None
    if c.returncode == 0:
        return None
    said = (c.stdout + c.stderr).strip().splitlines()
    return f"  PR #{n}: {said[-1] if said else 'carries no verification evidence'}"


#: The scanner. Written once, in one place, so pre-push and the scheduled sweep
#: over the public repositories cannot drift apart on what a credential is.
sys.path.insert(0, os.path.expanduser("~/Documents/code/claude-estate/scripts"))
try:
    import repo_secrets
except Exception:                      # a missing scanner must not wedge every push
    repo_secrets = None


def secrets(shas):
    """Credentials in the lines this push ADDS.

    On 2026-08-23 two repositories were about to be made public and the scan
    that cleared them was written by hand in a scratchpad, run once, and thrown
    away. The founder's reply: "why isnt this automated already, thats why we
    are always firefighting". A push is the moment the estate loses control of a
    string, so it is the moment to look.

    Only added lines, and only against each commit's first parent. Scanning the
    whole tree on every push would refuse pushes for keys somebody else
    committed in 2024, which is the sweep's job and a different conversation.
    """
    if repo_secrets is None:
        return []
    found = []
    for sha in shas:
        for h in repo_secrets.scan_diff(".", f"{sha}^..{sha}"):
            if h["blocking"]:
                found.append(f"  {h['kind']:<18} {h['path']}:{h['line']}  (commit {sha[:8]})")
    return found


def dependencies():
    """Refuse a push that leaves a dependency neither drilled nor dismissed.

    The check already existed and already refused. It just refused in the wrong
    place. `drills/audit.py --ci` runs as the `guards` job on main, so an
    unclassified host is caught after the push, on the branch every session
    pushes to, and it goes red for all of them until somebody notices whose
    commit did it. Measured 2026-08-23: fly.io and api.fly.io sat unclassified
    and the guards job failed on every push to claude-guards main.

    Running it here moves the refusal to the person who added the host, while
    they are still holding the change. Same script, same exit code, earlier.
    """
    audit = os.path.join(os.getcwd(), "drills", "audit.py")
    if not os.path.isfile(audit):
        return []                          # a repo with no dependency register
    r = subprocess.run([sys.executable, audit, "--ci"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return []
    return [l for l in r.stdout.splitlines() if l.strip()]


def main():
    problems = []
    stale_problems = []
    evidence_problems = []
    secret_problems = []
    for line in sys.stdin:
        parts = line.split()
        if len(parts) < 4:
            continue
        _, local, _, remote = parts[:4]
        if set(local) == {"0"}:            # a branch deletion ships nothing
            continue
        shas = commits(local, remote)
        secret_problems.extend(secrets(shas))
        behind = stale(parts[0], local, shas)
        if behind:
            stale_problems.append(behind)
        missing = evidence(parts[0], shas)
        if missing:
            evidence_problems.append(missing)
        for name, why in features(local, shas).items():
            for kind in ("demo", "onboarding"):
                path = f"docs/{kind}/{name}.md"
                n = readable(local, path)
                if n is None:
                    problems.append(f"  {path} is missing        ({why})")
                elif n < MIN_BODY_CHARS:
                    problems.append(
                        f"  {path} is a stub, {n} characters of prose, {MIN_BODY_CHARS} is the floor")
    dep_problems = dependencies()
    if dep_problems:
        sys.stderr.write(
            "\npush refused: a dependency is neither drilled nor dismissed (LAW 19).\n\n"
            + "\n".join("  " + l for l in dep_problems) + """

Every host and credential in this tree is one of two things: something a drill
proves we survive losing, or something dismissed in writing with a reason. There
is no third state, because an unclassified dependency reads as covered.

Classify each one in drills/dependencies.json, then push again. This is the same
check the guards job runs on main; it is here so it refuses you instead of
turning main red for every other session.
""")
        return 1
    if secret_problems:
        sys.stderr.write(
            "\npush refused: this push adds a live credential (LAW 21).\n\n"
            + "\n".join(secret_problems) + """

A push is the last moment the estate still controls this string. After it, the
value is on a remote, in every clone, in every fork and in the caches, and the
only honest response is to rotate the key and prove the rotation with a command.

Take the value out of the commit, put it in the environment or the keychain, and
rewrite the commit that carries it. Amending is not enough if it is already in an
earlier commit in this push.

Everything above is anchored on a vendor prefix and a real length, so it is a key
or it is a fixture. If it is genuinely a fixture, move it under a fixtures/ or
tests/ path, which this gate already exempts.
""")
        return 1
    if stale_problems:
        sys.stderr.write(
            "\npush refused: this branch has not been refreshed on main (LAW 7).\n\n"
            + "\n".join(stale_problems) + """

A stale branch does not fail honestly. It fails as somebody else's bug, naming
files and tests your diff never touched, and you then spend an hour debugging a
fiction. Refresh it before anyone reads it:

  git fetch origin main && git merge origin/main --no-edit

Merge, never rebase, and never force push -- the remote moves by itself here, so
a force push destroys work you never saw arrive.

If this genuinely must go stale, put one honest line in the commit message:

  Stale-OK: <why>
""")
        return 1
    if evidence_problems:
        sys.stderr.write(
            "\npush refused: this pull request has no picture of the run (LAW 22).\n\n"
            + "\n".join(evidence_problems) + """

Pasted output is typed by hand in seconds and reads the same whether the run
happened or not. Attach a photograph of it instead:

  pr-evidence.py shot - --out /tmp/p.png --title "pytest -q" < run.log
  pr-evidence.py attach --pr <n> /tmp/p.png --caption "what it proves"

The image is committed into this branch under docs/evidence/pr-<n>/, not into
GitHub's attachment store, so the proof leaves with the code when we do.

If this push genuinely cannot carry evidence, say why in the commit message:

  No-Evidence: <why>
""")
        return 1
    if not problems:
        return 0
    sys.stderr.write(
        "\npush refused: a feature is shipping without a way for the founder to see it.\n\n"
        + "\n".join(problems) + """

The rule, and why it is a rule: shipping code that works and leaving a person to
work out how to use it is shipping a defect. Two files fix it.

  docs/demo/<name>.md         what he sees when it runs, and what it just did
  docs/onboarding/<name>.md   what he needs to know, and how to turn it off

Write them, amend or add a commit, and push again.
""")
    return 1


if __name__ == "__main__":
    sys.exit(main())
