{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "PYTEST_XDIST_AUTO_NUM_WORKERS": "6"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "WebFetch(*)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/bin/Debug/**)",
      "Read(**/bin/Release/**)",
      "Read(**/obj/**)",
      "Read(**/.turbo/**)",
      "Read(**/storybook-static/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)",
      "Read(**/uv.lock)",
      "Read(**/packages.lock.json)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/*.map)",
      "Read(**/coverage/**)",
      "Read(**/htmlcov/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/__pycache__/**)",
      "Read(**/*.log)",
      "Read(graphify-out/**)",
      "Read(.venv/**)",
      "Read(**/.venv/**)",
      "Read(store/_cache/**)",
      "Read(store/golden_runs/**)",
      "Read(store/control_center/runs/**)",
      "Read(**/*.png)",
      "Read(**/*.jpg)",
      "Read(**/*.jpeg)",
      "Read(**/*.gif)",
      "Read(**/*.pdf)",
      "Read(**/*.zip)",
      "Read(**/*.bundle)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.db-shm)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/sync-guard.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/laws-link-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/peer-loop-fence.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/memory-loop.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/canonical-root-guard.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/single-session-guard.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/friction-relay.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/feed-guard.py SessionStart",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/estate-state-relay.py SessionStart",
            "timeout": 20
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/opa-hook.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/secret-scrub.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/laws-link-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/vendor-lock-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/dod-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/prompt-ledger.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/close-guard.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/founder-deliver.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/blocker-guard.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/credential-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/feed-guard.py Stop",
            "timeout": 15
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/directive-capture.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/board-deliver.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/feed-guard.py UserPromptSubmit",
            "timeout": 15
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/scope-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/config-syntax-guard.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/opa-hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/dupe-work-fence.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/pr-cap-guard.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/rule-guard.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/ticket-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/credential-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/opa-hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/ticket-gate.py"
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/opa-hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Documents/code/claude-guards/hook-run.py $HOME/Documents/code/claude-guards/research-capture.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 $HOME/Documents/code/claude-guards/statusline-context.py",
    "padding": 0
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Read-only inspection of any file on this machine, including binaries and installed application bundles, with tools such as strings, nm, otool, file, xxd, head, sed -n, grep and rg. Reading a file to learn how it works is not exfiltration.",
      "Reading, writing and running files under ~/.claude/ (settings.json, skills/, plugins/, projects/) and under ~/Documents/code/claude-guards/ (the guard scripts). Both are the user's own agent configuration.",
      "gh CLI commands against the user's own repositories, including gh api, gh pr, gh run, gh workflow, gh issue, gh release, gh variable set and gh secret set/delete. Secret values are supplied from a file or an environment variable and are never printed.",
      "flyctl / fly commands against the user's own Fly.io apps, including fly status, fly logs, fly deploy, fly machine, fly volumes, fly secrets set and fly ssh console -C.",
      "Running the repository's own scripts under scripts/, ops/ and tools/ with .venv/bin/python or python3, in report mode and with --fix.",
      "Running a nested claude process (for example claude -p ...) against a throwaway CLAUDE_CONFIG_DIR to test a settings, permission or hook change.",
      "git worktree add / list / remove under /private/tmp/claude-501/** and ~/Documents/code/wt-*, and ordinary git operations in those trees.",
      "launchctl list, print, kickstart, bootout, bootstrap, enable and disable for the user's own com.prospector.* and com.hermes.* LaunchAgents.",
      "Running test suites, linters, builds and the POPDD gate anywhere in the user's own checkouts, including npm, npx, dotnet, pytest, ruff and vitest.",
      "Merging the user's own pull requests in his own GitHub repositories, with gh pr merge or the equivalent gh api PUT repos/OWNER/REPO/pulls/N/merge, including --squash and --delete-branch. Standing instruction from the founder, 2026-08-23, in his own words: 'i dont need friction, agents should be able to merge'. A merge here is recoverable: the branch, the commits and git revert are all still in the repository. Stopping to ask him for each one is the loop he is telling us to stop."
    ],
    "environment": [
      "$defaults",
      "This is the user's own developer laptop. ~/Documents/code/prospector is their own repository (github.com/chidionyema/prospector). ~/.claude is their own agent configuration and the guard scripts live in ~/Documents/code/claude-guards. Reading, editing and running things in any of these is self-administration, not third-party access.",
      "The user owns the GitHub repo chidionyema/prospector and the Fly.io organisation hosting the prospector-*, store-*, mumchimp-* and tie-* apps. Commands aimed at those resources administer the user's own infrastructure.",
      "Standing instruction from the user: prefer acting to asking on routine estate work. Interruptions on ordinary read, inspect, deploy and repo-administration commands cost more than they protect."
    ]
  },
  "model": "sonnet"
}
